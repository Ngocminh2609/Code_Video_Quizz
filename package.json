  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/tailwind-v4": "4.0.536",
    "lucide-react": "^1.59.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "node scripts/renderAll.mjs --first",
    "render:all": "node scripts/renderAll.mjs",
    "render:single": "remotion render src/index.ts MainQuiz out/quiz.mp4",
    "render:still": "remotion still src/index.ts MainQuiz out/preview.png --frame=240",
